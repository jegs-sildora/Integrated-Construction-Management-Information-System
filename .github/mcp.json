{
  "mcpServers": {
    "playwright": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {},
      "tools": [
        "browser_console_messages",
        "browser_network_request",
        "browser_network_requests",
        "browser_snapshot",
        "browser_take_screenshot",
        "browser_get_config",
        "browser_pdf_save"
      ]
    }
  }
}
